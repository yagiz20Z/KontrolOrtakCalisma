/**
  * @brief  Function implementing the defaultTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_Verileri */
void Verileri(void *argument)
{
  /* USER CODE BEGIN Verileri */
  	ortatanim_t data;
    data.ilk=0;
    I2C_HandleTypeDef hi2c2;

  /* Infinite loop */
  for(;;)
  {
//	data.i2c_status = HAL_I2C_Mem_Read(hi2c, DevAddress, MemAddress, MemAddSize, pData, Size, Timeout);

    data.i2c_status = HAL_I2C_Mem_Read(&hi2c2, AS5600_I2C_ADDR, AS5600_REG_RAW_ANGLE, I2C_MEMADD_SIZE_8BIT, data.buf, 1, 100);
	  if (data.i2c_status == HAL_OK)
	  {
	      data.raw_angle = (uint16_t)(data.buf[0] << 8) | data.buf[1];
	      data.angle_in_degrees = (float)data.raw_angle * 360.0f / 4096.0f;

	      data.son = data.angle_in_degrees;

	      osDelay(200);

	      data.delta = data.son - data.ilk;

	      if (data.delta > 180.0f) {
	          data.delta -= 360.0f;
	      } else if (data.delta < -180.0f) {
	          data.delta += 360.0f;
	      }



	      data.acisal = data.delta / 200.0f;
        
	  }

    osDelay(1);
  }
  /* USER CODE END Verileri */
}

