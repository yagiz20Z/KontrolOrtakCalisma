/* USER CODE BEGIN Header_Verileri */
/**
  * @brief  Function implementing the defaultTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_Verileri */
void Verileri(void *argument)
{
  /* USER CODE BEGIN Verileri */
  	ortatanim_t data;
    data.ilkaci=0;


  /* Infinite loop */
  for(;;)
  {

    data.i2c_status = HAL_I2C_Mem_Read(&hi2c2, AS5600_I2C_ADDR, AS5600_REG_RAW_ANGLE, I2C_MEMADD_SIZE_8BIT, data.buf, 1, 100);
    							// buradaki tanımlamaları tanimlama.h'dan değiştir.

    if (data.i2c_status == HAL_OK)
	  {
	      data.raw_angle = (uint16_t)(data.buf[0] << 8) | data.buf[1];
	      data.angle_in_degrees = (float)data.raw_angle * 360.0f / 4096.0f;		// hamverinin dereceye dönüştürüldüğü kısım.

	      data.sonaci = data.angle_in_degrees;

	      osDelay(200);

	      data.delta = data.sonaci - data.ilkaci;

	      if (data.delta > 180.0f) {				//bu kısım "-" kısmının ayarlandığı kısım kaldırılabilir.
	          data.delta -= 360.0f;
	      } else if (data.delta < -180.0f) {
	          data.delta += 360.0f;
	      }

	      data.acisalhiz = data.delta / 200.0f;
        
	  }
    else {
    	HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
	      osDelay(200);

    }

    osDelay(1);
  }
  /* USER CODE END Verileri */
}

